---
import Logo from "@/components/Logo.astro";
import { site } from "@/config/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-6 px-gutter pt-8 text-sm text-muted md:grid-cols-2 md:px-6 pb-24">
    <div>
      <Logo class="text-xl" />
      <p class="mt-3 max-w-sm">{site.tagline}</p>
    </div>
    <p class="text-xs md:self-end md:text-right">
      © {year}{" "}
      <a href="https://santinoaued.github.io" class="underline" target="_blank" rel="noopener noreferrer">Santino Aued</a>
    </p>
  </div>
</footer>
